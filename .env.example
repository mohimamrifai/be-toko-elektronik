PORT=5000
# Salin ke `.env` atau `.env.local` (keduanya didukung; `.env.local` menang jika keduanya ada)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/toko_elektronik

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# SMTP (opsional di development — token reset dicatat ke log jika kosong)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@tokoelektronik.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Midtrans (sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false
